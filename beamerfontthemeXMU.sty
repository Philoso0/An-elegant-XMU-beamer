\mode<presentation>

%%%%%%%%%%%% 基础字体族设置 %%%%%%%%%%%%
% rmfamily: 有衬线（正文推荐）
% sffamily: 无衬线（标题/导航）
% ttfamily: 等宽（代码）

\setbeamerfont{normal text}{family=\rmfamily,size=\normalsize,series=\mdseries}

\setbeamerfont{rm}{family=\rmfamily,series=\mdseries}
\setbeamerfont{sf}{family=\sffamily,series=\mdseries}
\setbeamerfont{tt}{family=\ttfamily,series=\mdseries}

%%%%%%%%%%%% 标题系统 %%%%%%%%%%%%

\setbeamerfont{title}{family=\rmfamily,size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{size=\Large,parent=title}

\setbeamerfont{author}{size=\LARGE,parent=title}
\setbeamerfont{institute}{size=\normalsize,series=\bfseries,parent=rm}
\setbeamerfont{date}{size=\normalsize,parent=rm}

%%%%%%%%%%%% Frame 标题 %%%%%%%%%%%%

\setbeamerfont{frametitle}{size=\huge,series=\bfseries,parent=rm}
\setbeamerfont{framesubtitle}{size=\Large,parent=frametitle}

%%%%%%%%%%%% 目录 / 导航 %%%%%%%%%%%%

\setbeamerfont{section in toc}{family=\sffamily,size=\Large,series=\bfseries}
\setbeamerfont{section in head/foot}{size=\normalsize,parent={section in toc}}
\setbeamerfont{subsection in toc}{size=\small,series=\mdseries,parent={section in toc}}

%%%%%%%%%%%% 正文与元素 %%%%%%%%%%%%
\setbeamerfont{normal text}{size=\normalsize,series=\mdseries}
\setbeamerfont{item}{size=\normalsize,series=\mdseries,parent=normal text}
\setbeamerfont{caption}{size=\footnotesize,parent=tt}

%%%%%%%%%%%% Block %%%%%%%%%%%%

\setbeamerfont{block title}{size=\large,series=\bfseries}
\setbeamerfont{block body}{size=\normalsize,parent=normal text}

\mode<all>