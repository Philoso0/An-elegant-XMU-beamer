% command for building the first slide of the presentation
\newcommand \maketitlepage{
    {
    \usebackgroundtemplate{
    \includegraphics[width=\paperwidth]{xmulogo/section bg.pdf}
    }
\begin{frame}[plain]
    % Print the title page as the first slide
    \titlepage
\end{frame}
}
}
